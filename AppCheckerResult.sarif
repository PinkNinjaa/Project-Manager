{"$schema":"https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.4.json","version":"2.1.0","runs":[{"results":[{"ruleId":"acc-TabIndexShouldBeDefinedForInteractiveControl","ruleIndex":0,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"cmpDetFinish.conFinScrim.btnFinDismiss.TabIndex"}},"logicalLocations":[{"fullyQualifiedName":"cmpDetFinish.conFinScrim.btnFinDismiss.TabIndex"}],"properties":{"module":"cmpDetFinish","type":"cmpDetFinish.conFinScrim.btnFinDismiss","member":"TabIndex"}}],"properties":{"level":"Medium"}},{"ruleId":"acc-TabIndexShouldBeDefinedForInteractiveControl","ruleIndex":0,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"cmpDetReroute.conRerScrim_1.btnRerDismiss_1.TabIndex"}},"logicalLocations":[{"fullyQualifiedName":"cmpDetReroute.conRerScrim_1.btnRerDismiss_1.TabIndex"}],"properties":{"module":"cmpDetReroute","type":"cmpDetReroute.conRerScrim_1.btnRerDismiss_1","member":"TabIndex"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"App.OnStart"}},"logicalLocations":[{"fullyQualifiedName":"App.OnStart"}],"properties":{"module":"App","type":"App","member":"OnStart"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrDetails.OnVisible"}},"logicalLocations":[{"fullyQualifiedName":"scrDetails.OnVisible"}],"properties":{"module":"scrDetails","type":"scrDetails","member":"OnVisible"}}],"properties":{"level":"Medium"}},{"ruleId":"app-CollectingReadOnlyTable","ruleIndex":1,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrDetails.OnVisible"}},"logicalLocations":[{"fullyQualifiedName":"scrDetails.OnVisible"}],"properties":{"module":"scrDetails","type":"scrDetails","member":"OnVisible"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"cmpDetEditWorkflow.btnWfLoadTemplate.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"cmpDetEditWorkflow.btnWfLoadTemplate.OnSelect"}],"properties":{"module":"cmpDetEditWorkflow","type":"cmpDetEditWorkflow.btnWfLoadTemplate","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"cmpDetEditWorkflow.conWfPanel.galWfRows.conWfRowPhase.btnWfPhDelete.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"cmpDetEditWorkflow.conWfPanel.galWfRows.conWfRowPhase.btnWfPhDelete.OnSelect"}],"properties":{"module":"cmpDetEditWorkflow","type":"cmpDetEditWorkflow.conWfPanel.galWfRows.conWfRowPhase.btnWfPhDelete","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-IndexedAccessViaCopy","ruleIndex":3,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"cmpAccordionList.conAlRoot.galAlRows.Items"}},"logicalLocations":[{"fullyQualifiedName":"cmpAccordionList.conAlRoot.galAlRows.Items"}],"properties":{"module":"cmpAccordionList","type":"cmpAccordionList.conAlRoot.galAlRows","member":"Items"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrMyTasks.tmrTskFinish.OnTimerEnd"}},"logicalLocations":[{"fullyQualifiedName":"scrMyTasks.tmrTskFinish.OnTimerEnd"}],"properties":{"module":"scrMyTasks","type":"scrMyTasks.tmrTskFinish","member":"OnTimerEnd"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrDetails.btnDetAdvance.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scrDetails.btnDetAdvance.OnSelect"}],"properties":{"module":"scrDetails","type":"scrDetails.btnDetAdvance","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":2,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"scrDetails.btnDetFieldsRebuild_1.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"scrDetails.btnDetFieldsRebuild_1.OnSelect"}],"properties":{"module":"scrDetails","type":"scrDetails.btnDetFieldsRebuild_1","member":"OnSelect"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Collection is initialized but never updated"}},"properties":{"howToFix":["Replace the Collect or ClearCollect with a named formula on App.Formulas. For example, MyTable = Filter(source, condition). Named formulas are computed when their inputs change and do not carry the tracking cost of a collection."],"whyFix":"Collections are meant to be updated. Power Apps does extra work to keep track of every collection so that anything depending on it stays in sync when the data changes. When the data never changes after it is set, that tracking work is wasted. A named formula gives the same data without the extra cost.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Mutating a collection or data source inside ForAll may trigger excessive rule re-evaluation"}},"properties":{"howToFix":["Since ForAll returns a table, pass its result as input to the mutation function in a single batched call. For example, replace ForAll(source, Collect(c, { ... })) with Collect(c, ForAll(source, { ... })); the same pattern applies to Patch and Remove. A single batched mutation emits one change notification instead of one per iteration.","For trivial per-row updates or deletions against a data source, prefer the delegable UpdateIf or RemoveIf functions called once outside ForAll instead of iterating with ForAll."],"whyFix":"Using Collect, Patch, Remove, or another mutation function inside the body of ForAll mutates the target collection or data source once per iteration. Every control property that depends on that collection or data source re-evaluates on each mutation, which can turn a small loop into thousands of rule evaluations and, for connected data sources, a network request per row.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-IndexedAccessViaCopy","messageStrings":{"issue":{"text":"Use Index to read a record at a given position"}},"properties":{"howToFix":["Replace Last(FirstN(t, n)) with Index(t, Min(CountRows(t), n)) — t and n stay the same as in your original expression. The Min keeps the original behavior — when n is in range it returns the n-th row, and when n is larger than the row count it returns the last row instead of an error. If you already know that n is between 1 and CountRows(t), you can simplify to Index(t, n).","Replace First(LastN(t, n)) with Index(t, Max(1, CountRows(t) - n + 1)) — t and n stay the same as in your original expression. The Max keeps the original behavior — when n is in range it returns the n-th-from-end row, and when n is larger than the row count it returns the first row instead of an error. If you already know that n is between 1 and CountRows(t), you can simplify to Index(t, CountRows(t) - n + 1)."],"whyFix":"In expressions like Last(FirstN(t, n)) and First(LastN(t, n)) — where t is the table and n is the row position — both forms materialize a copy of the table up to n rows just to return one record at the boundary. Index(t, ...) returns the record at a position directly without building the intermediate copy, avoiding the copy cost and any per-row work the copy would trigger. When n is between 1 and the row count of t (identifiers t and n should stay the same as in your original expression), the two forms return the same record; when n exceeds the row count Index errors while the FirstN/LastN forms clamp to a boundary row, so use a clamping formula such as Min(CountRows(t), n) if your data may be smaller than n.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}